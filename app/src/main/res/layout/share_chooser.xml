<?xml version="1.0" encoding="utf-8"?>


<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/colorWhite"
    android:orientation="vertical">


    <com.google.android.ads.nativetemplates.TemplateView
        android:visibility="gone"
        android:id="@+id/ad_template_1"

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:gnt_template_type="@layout/gnt_small_template_view" />


    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="horizontal">


        <com.google.android.material.textview.MaterialTextView

            android:layout_marginRight="10dp"
            android:id="@+id/shareTxt"
            android:layout_gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentLeft="true"
            android:layout_centerVertical="true"
            android:text="Share as:">

        </com.google.android.material.textview.MaterialTextView>

        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.radiobutton.MaterialRadioButton

                android:id="@+id/pdfRadio"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true">


            </com.google.android.material.radiobutton.MaterialRadioButton>


            <com.google.android.material.textview.MaterialTextView

                android:clickable="true"

                android:id="@+id/sharePDFTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PDF">


            </com.google.android.material.textview.MaterialTextView>


        </LinearLayout>


        <LinearLayout
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:id="@+id/imgRadioParent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">




            <com.google.android.material.radiobutton.MaterialRadioButton

                android:id="@+id/imageRadio"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content">


            </com.google.android.material.radiobutton.MaterialRadioButton>


            <com.google.android.material.textview.MaterialTextView

                android:clickable="true"

                android:id="@+id/shareImageTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Image">


            </com.google.android.material.textview.MaterialTextView>


        </LinearLayout>




    </LinearLayout>


    <RelativeLayout
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.2"
        android:background="@color/gray_cool">

    </RelativeLayout>



    <LinearLayout

        android:id="@+id/qualityControl"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">



        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <com.google.android.material.textview.MaterialTextView


                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Quality: "></com.google.android.material.textview.MaterialTextView>


            <com.google.android.material.textview.MaterialTextView

                android:id="@+id/qualityTxt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good"
                android:textStyle="bold">

            </com.google.android.material.textview.MaterialTextView>



        </LinearLayout>



        <com.google.android.material.slider.Slider
            android:id="@+id/qualitySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:value="51"
            android:valueFrom="2"
            android:valueTo="100">

        </com.google.android.material.slider.Slider>



    </LinearLayout>


    <RelativeLayout
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.2"
        android:background="@color/gray_cool">

    </RelativeLayout>



    <LinearLayout

        android:layout_margin="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expected Size: ">

        </com.google.android.material.textview.MaterialTextView>

        <com.google.android.material.textview.MaterialTextView

            android:id="@+id/expectedSize"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4.5 mb"
            android:textStyle="bold">

        </com.google.android.material.textview.MaterialTextView>


    </LinearLayout>

    <RelativeLayout
        android:layout_marginBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:alpha="0.2"
        android:background="@color/gray_cool">

    </RelativeLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="10dp"
        android:orientation="vertical">


        <LinearLayout
            android:id="@+id/passwordProtectRootLL"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.textview.MaterialTextView


                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentLeft="true"
                android:layout_centerVertical="true"
                android:text="Password protect:">

            </com.google.android.material.textview.MaterialTextView>


            <com.google.android.material.switchmaterial.SwitchMaterial
                android:checked="false"
                android:id="@+id/passwordProtectCB"
                android:layout_marginLeft="20dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </com.google.android.material.switchmaterial.SwitchMaterial>


        </LinearLayout>

        <com.google.android.material.textfield.TextInputEditText

            android:id="@+id/password"
            android:hint="Password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

        </com.google.android.material.textfield.TextInputEditText>







    </LinearLayout>



</LinearLayout>



